# ─────────────────────────────────────────────────────────────────────────────
#  Wraith + Aegis — optional API keys for skill scripts that call external services.
#
#  Copy to ~/.wraith/keys.env and fill in only the ones you need. The wraith/aegis
#  shell commands source this file (in a subshell) before launching, so the keys are
#  available to the tools they run. Everything works without keys — skills that need
#  one just skip that enrichment step. NEVER commit your filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Recon / OSINT (Wraith) ──
export SHODAN_API_KEY=
export HIBP_API_KEY=
export GITHUB_TOKEN=
export VIRUSTOTAL_API_KEY=
export VT_API_KEY=
export GREYNOISE_API_KEY=
export DEHASHED_EMAIL=
export DEHASHED_API_KEY=
export URLSCAN_API_KEY=
export NVD_API_KEY=

# ── Cloud (both) ──
export AWS_PROFILE=
export AWS_DEFAULT_REGION=
export AZURE_TENANT_ID=
export AZURE_CLIENT_ID=
export AZURE_CLIENT_SECRET=
export AZURE_SUBSCRIPTION_ID=

# ── Identity (both) ──
export OKTA_ORG_URL=
export OKTA_API_TOKEN=

# ── Threat intel (Aegis) ──
export MISP_URL=
export MISP_API_KEY=
export OPENCTI_URL=
export OPENCTI_TOKEN=
export ABUSEIPDB_API_KEY=
export THEHIVE_URL=
export THEHIVE_API_KEY=

# ── SIEM (Aegis) ──
export SPLUNK_HOST=
export SPLUNK_PORT=
export SPLUNK_USERNAME=
export SPLUNK_PASSWORD=
export ES_HOSTS=

# ── LLM (a few enrichment scripts) ──
export OPENAI_API_KEY=
